{
  "name": "wortklinge",
  "version": "0.3.0",
  "private": true,
  "description": "失语纪元 · Wortklinge — a dark pixel RPG where every monster is a German word.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
